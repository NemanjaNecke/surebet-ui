{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "surebet-ui",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "kvotaradar.online",
      "custom_domain": true
    },
    {
      "pattern": "www.kvotaradar.online",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/surebet-ui/browser",
    "not_found_handling": "single-page-application"
  }
}
